# Copia este archivo a ".env" (nunca subas el ".env" real a git) y completa
# con los datos de tu servidor de PRUEBAS/DESARROLLO. NO pongas aqui la
# credencial de produccion.
DB_SERVER=DESKTOP-49S3GJO
DB_PORT=1433
DB_NAME=MinventSoftRoteland
DB_USER=sa
DB_PASSWORD=123
# true si el server exige encriptacion (ej. Azure SQL), false para un SQL
# Server on-prem tipico sin certificado configurado.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Ruta al Excel a migrar.
EXCEL_PATH=./ANABEL.xlsx
# Nombre de la hoja dentro del Excel.
EXCEL_SHEET=Hoja1

# Usuario que queda registrado en FechaRegistro/UsuarioRegistro de cada fila
# nueva (Categorias, Productos, Precios, etc.).
USUARIO_MIGRACION=MIGRACION_ANABEL

# --- Opcionales: solo si el script no puede resolverlos solo ---
# Id de PreciosCategorias a usar para "costo" y "venta". Si no se ponen,
# el script busca automaticamente la unica fila con Tipo=0 (costo) y
# Tipo=1 (venta); si hay mas de una de cada tipo, el script se detiene y
# pide que se fijen aqui explicitamente.
# CATEGORIA_PRECIO_COSTO_ID=
# CATEGORIA_PRECIO_VENTA_ID=

# Id de Almacenes a usar en Precios.AlmacenId. Si se deja vacio, los precios
# se insertan con AlmacenId = NULL (validos para todos los almacenes segun
# la logica actual del sistema).
# ALMACEN_ID=
