# ==== Equivalente a dbConnect.TXT (gs_Ip, gs_UsuarioSql, gs_ClaveSql, gs_NombreBD, gs_CarpetaRaiz) ====
# Copia este archivo como .env y completa. NUNCA subas .env al repositorio.
DB_SERVER=127.0.0.1
DB_INSTANCE=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=DBDinoM
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Misma carpeta raiz que usa el escritorio (gs_CarpetaRaiz). Las imagenes se guardan en
# <CARPETA_RAIZ>\Imagenes\Imagenes Categoria  y  <CARPETA_RAIZ>\Imagenes\Imagenes Empresa
CARPETA_RAIZ=C:\BD

# ==== Servidor ====
PORT=3001
NODE_ENV=development
# Genera uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_HORAS=10
# Origen del frontend en desarrollo (Vite)
CORS_ORIGIN=http://localhost:5173
