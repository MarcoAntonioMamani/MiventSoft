{
  "name": "miventsoft-server",
  "version": "0.1.0",
  "private": true,
  "description": "MiventSoft Web - API (capas Datos / Negocio / Rutas, migrado de VB.NET)",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
